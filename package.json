{
  "name": "pi-todone",
  "version": "0.5.1",
  "description": "Todo 完成义务闸 + 证明点协议：todo 标 completed 必须附 evidence（格式闸），空闲时有 pending 注入证明义务（证明/继续/卡点），语义验证交给 subagent 系",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types src/demo.ts && node --experimental-strip-types test/e2e.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "todo",
    "evidence",
    "completion",
    "anti-laziness"
  ],
  "author": "nuctori",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": false
    }
  },
  "files": [
    "src/",
    "README.md",
    "README.en.md"
  ]
}



